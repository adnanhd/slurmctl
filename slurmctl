#!/bin/bash
set -euo pipefail

# Resolve tool directory (where this script lives, for lib/ and libexec/)
SLURMCTL_SRC_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
export SLURMCTL_SRC_DIR

# Resolve user's project directory
SLURMCTL_PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
export SLURMCTL_PROJECT_ROOT

# Source common library
source "$SLURMCTL_SRC_DIR/lib/common.sh"
source "$SLURMCTL_SRC_DIR/lib/sacct.sh"

# Parse global flags before subcommand
while [ $# -gt 0 ]; do
  case "$1" in
    --job|-j)
      export SLURMCTL_JOBID="$2"
      shift 2
      ;;
    --help|-h)
      set -- help
      break
      ;;
    -*)
      printf "${RED}Unknown flag: %s${RESET}\n" "$1" >&2
      exit 1
      ;;
    *)
      break
      ;;
  esac
done

# Subcommand dispatch
cmd="${1:-help}"
shift || true

libexec="$SLURMCTL_SRC_DIR/libexec/slurmctl/${cmd}.sh"
if [ ! -f "$libexec" ]; then
  printf "${RED}Unknown command: %s${RESET}\n" "$cmd" >&2
  printf "Run ${CYAN}slurmctl help${RESET} for usage.\n" >&2
  exit 1
fi

source "$libexec" "$@"
