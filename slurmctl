#!/bin/bash
set -euo pipefail

# Resolve tool directory (where this script lives, for lib/ and libexec/)
SLURMCTL_SRC_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
export SLURMCTL_SRC_DIR

# Resolve user's project directory
SLURMCTL_PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
export SLURMCTL_PROJECT_ROOT

# Source shared libraries: common helpers + one thin API per Slurm CLI tool.
source "$SLURMCTL_SRC_DIR/lib/common.sh"
source "$SLURMCTL_SRC_DIR/lib/squeue.sh"
source "$SLURMCTL_SRC_DIR/lib/scontrol.sh"
source "$SLURMCTL_SRC_DIR/lib/sacct.sh"
source "$SLURMCTL_SRC_DIR/lib/sreport.sh"
source "$SLURMCTL_SRC_DIR/lib/graphic.sh"

# Extract --job/-j from anywhere in argv; pass --help through to subcommands
cmd=""
rest=()
while [ $# -gt 0 ]; do
  case "$1" in
    --job|-j)
      export SLURMCTL_JOBID="$2"
      shift 2
      ;;
    --help|-h)
      rest+=("--help")
      shift
      ;;
    *)
      rest+=("$1")
      shift
      ;;
  esac
done

# First non-flag arg is the subcommand
cmd="${rest[0]:-help}"
rest=("${rest[@]:1}")

# --help with no subcommand → global help
if [ "$cmd" = "--help" ]; then
  cmd="help"
  rest=()
fi

libexec="$SLURMCTL_SRC_DIR/libexec/slurmctl/${cmd}.sh"
if [ ! -f "$libexec" ]; then
  printf "${RED}Unknown command: %s${RESET}\n" "$cmd" >&2
  printf "Run ${CYAN}slurmctl help${RESET} for usage.\n" >&2
  exit 1
fi

source "$libexec" "${rest[@]+"${rest[@]}"}"
